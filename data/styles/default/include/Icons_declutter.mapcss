node|z17[amenity=pub],
area|z17[amenity=pub],
node|z17[amenity=biergarten],
area|z17[amenity=biergarten],
node|z17[amenity=hookah_lounge],
area|z17[amenity=hookah_lounge]
{icon-min-distance: 200;}

