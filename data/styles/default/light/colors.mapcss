@green2: #CFE7C6;
@green3: #C9E4C0;
@green4: #C4E1BA;
@green5: #C6E2BC;
@forest: #C2DFB6;
@green6: #9BBF8E;
@flowers: #C9E4C0;

/* 4.LANDUSE */
/*4.1 Main landuse*/

@pedestrian_area: #ECEBE7;
@pedestrian_area_light: #EFEEEA;
@platform: #E4E2DD;
