@farmyard: #EEEBDD;

/*4.2 Aerodrome*/

@aerodrome0: #E6E4EE;
@aerodrome1: #E4E2EC;
@aerodrome2: #E2E0EA;
@aerodrome3: #E0DEE8;
@aerodrome4: #DEDCE6;
@aerodrome5: #DCDAE4;

/* 4.3 Barriers */
@fence: #B8B8B8;
