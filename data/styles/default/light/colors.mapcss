/* Road outlines */

@casing_highway: #E2AE3C;
@casing_major: #E9C877;
@casing_minor: #D9D7D1;

/* 5.2 Bridges */

@bridge_background: #F7F6F3;
@bridge_casing: #BDBBB5;

/* 5.3 Tunnels */

@trunk_tunnel: #F9D57F;
