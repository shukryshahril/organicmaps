/* 1.BASEMAP */

@background: #F4F3F0;

/* 2.BOUNDARY */

@border_country: #9A98A0;
@border_region: #B4B2BA;
@indigenous_lands: #734D26;

/* 3.NATURAL */
/* 3.1 Main natural */

@glacier: #FFFFFF;
@water: #A9D3F5;
@water_bad: #BCD7EA;
@water_intermittent: #D2E7F8;
@river: #8DC2EE;
@wetland: #B5CFD8;
@beach: #F4EBC9;
@barerock: #E6E3DC;
@scree: #E0DDD6;
@desert: #F1EAD3;

/*3.2 Vegetation*/

@green0: #DFEFD9;
@green1: #D8ECD1;
