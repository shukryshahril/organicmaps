/* 4.4 Buildings */

@building0: #E9E8E5;
@building1: #E3E2DE;
@building_border0: #D6D4CF;
@building_border1: #CFCDC8;

/* 5.ROADS */
/* 5.1 All roads */

@trunk0: #F7C64B;
@trunk1: #F8CC5C;
@primary0:  #FCDA85;
@primary1: #FDDF94;
@primary2: #FEE4A3;
@secondary0: #FFFFFF;
@secondary1: #FFFFFF;
@tertiary: #FFFFFF;
@residential: #FFFFFF;
@pedestrian: #FAFAF8;
@footway: #CFCDC7;
@cycleway: #5B8DEF;
@construction: #D2D0C8;
@track: #A48F6A;
@path: #B88A63;
@path_expert: #6E5A4B;
